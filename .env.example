# Application
NODE_ENV=development
PORT=4000

# Database (PostgreSQL)
DATABASE_URL="postgresql://DB_USER:DB_PASSWORD@localhost:5432/smartelectric_db"

# Security & Auth Secrets (generate strong random strings in production)
OTP_SECRET="replace-with-strong-random-otp-secret"
JWT_SECRET="replace-with-strong-random-jwt-secret"
CONTACT_IP_SECRET="replace-with-strong-random-contact-ip-secret"

# Seed Admin User (used by prisma/seed.ts)
ADMIN_PHONE="09120000000"
ADMIN_NAME="مدیر سیستم"

# Payment Card Configuration (Card-to-Card)
SHOP_CARD_NUMBER="6037997000000000"
SHOP_CARD_HOLDER="نام صاحب حساب"
SHOP_BANK_NAME="نام بانک"
SHOP_SHEBA="IR000000000000000000000000"

# Upload Configuration
UPLOAD_DIR="public-uploads"
